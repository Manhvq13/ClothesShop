<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/img_product_thumbnail"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Product Thumbnail" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên Sản Phẩm"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_product_sku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKU: ABC123"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giá: 150.000đ"
                android:textColor="@color/design_default_color_error"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_product_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trạng thái: Hoạt động"
                android:textSize="13sp"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_stock_quantity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng: 100"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tv_stock_reserved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dự trữ: 5"
                    android:textSize="12sp"
                    android:textColor="#FF9800"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tv_stock_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sẵn có: 95"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginStart="8dp">

            <Button
                android:id="@+id/btn_edit"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text="Sửa"
                android:textSize="11sp"
                style="@style/Widget.AppCompat.Button.Small"
                android:layout_marginBottom="4dp"/>

            <Button
                android:id="@+id/btn_manage_stock"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text="Kho hàng"
                android:textSize="11sp"
                style="@style/Widget.AppCompat.Button.Small"
                android:backgroundTint="#2196F3"
                android:layout_marginBottom="4dp"/>

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:text="Xóa"
                android:textSize="11sp"
                android:backgroundTint="#F44336"
                style="@style/Widget.AppCompat.Button.Small" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>