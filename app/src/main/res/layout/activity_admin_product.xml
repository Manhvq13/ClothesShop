<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".view.admin.AdminProductActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_admin_product_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm Sản phẩm Mới"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <CheckBox
            android:id="@+id/cb_product_is_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sản phẩm đang hoạt động"
            android:checked="true"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/et_product_sku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SKU/Mã sản phẩm"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên sản phẩm"
            android:layout_marginBottom="12dp"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/et_inventory_quantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Số lượng tồn kho (Quantity)"
            android:layout_marginBottom="20dp"
            android:inputType="number" />

        <TextView
            android:id="@+id/tv_category_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Danh mục sản phẩm (Chưa triển khai)"
            android:layout_marginBottom="8dp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/et_image_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="URL Ảnh chính (Bắt buộc)"
            android:layout_marginBottom="12dp"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/et_image_alt_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả Alt Text cho ảnh"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_product_short_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả ngắn (tóm tắt)"
            android:lines="2"
            android:maxLines="3"
            android:layout_marginBottom="12dp"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/et_product_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mô tả chi tiết sản phẩm (Nội dung đầy đủ)"
            android:lines="5"
            android:gravity="top"
            android:layout_marginBottom="16dp"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/et_product_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá gốc (VND)"
            android:layout_marginBottom="12dp"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/et_product_sale_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá khuyến mãi"
            android:layout_marginBottom="24dp"
            android:inputType="numberDecimal" />


        <Button
            android:id="@+id/btn_save_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu Sản Phẩm"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>