<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".view.admin.AdminProductActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_admin_product_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm Sản phẩm Mới"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <EditText
            android:id="@+id/et_product_sku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SKU/Mã sản phẩm"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <EditText
            android:id="@+id/et_product_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên sản phẩm"
            android:layout_marginBottom="12dp"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/et_product_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá gốc (VND)"
            android:layout_marginBottom="12dp"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/et_product_sale_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Giá khuyến mãi"
            android:layout_marginBottom="16dp"
            android:inputType="numberDecimal" />

        <CheckBox
            android:id="@+id/cb_product_is_active"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sản phẩm đang hoạt động"
            android:checked="true"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btn_save_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu Sản Phẩm"/>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>